{
  "name": "gpay-remit-frontend",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@ledgerhq/hw-app-str": "^7.9.0",
    "@ledgerhq/hw-transport-webusb": "^6.28.1",
    "@stellar/freighter-api": "^3.1.0",
    "@stellar/stellar-sdk": "^11.2.2",
    "@albedo-link/intent": "^0.13.0",
    "axios": "^1.6.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.21.1",
    "react-scripts": "5.0.1"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "analyze:bundle": "node scripts/analyze-bundle.js",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "lint": "eslint src",
    "generate:types": "openapi-typescript ../backend/handlers/openapi.yaml -o src/types/api.ts",
    "check:types": "openapi-typescript ../backend/handlers/openapi.yaml -o src/types/api.ts && git diff --exit-code src/types/api.ts"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@faker-js/faker": "^8.4.1",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.5.1"
  }
}
