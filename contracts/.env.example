# Soroban RPC endpoint used for contract deployment.
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Stellar network passphrase. Testnet example:
#   Test SDF Network ; September 2015
# Mainnet example:
#   Public Global Stellar Network ; September 2015
SOROBAN_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Secret key for the admin/deployer identity. Never commit a real key.
# Generate or import a key with: stellar keys generate deployer --network testnet
ADMIN_SECRET=
