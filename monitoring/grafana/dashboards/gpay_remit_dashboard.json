{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "datasource",
          "uid": "grafana"
        },
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "API Request Rate & Latency",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 15
          },
          "unit": "reqps"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "title": "HTTP Request Rate by Endpoint",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (handler, status) (rate(gpay_remit_http_requests_total[5m]))",
          "legendFormat": "{{handler}} [{{status}}]",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 10
          },
          "unit": "s"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "id": 2,
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "title": "HTTP Request Latency (p50, p95, p99)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(gpay_remit_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p50 Median",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(gpay_remit_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p95 Latency",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(gpay_remit_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p99 Latency",
          "refId": "C"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 101,
      "title": "Error Rates & System Health",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 40
          },
          "unit": "reqps"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "id": 3,
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "title": "Error Rate by Endpoint (4xx & 5xx)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (handler, status) (rate(gpay_remit_http_requests_total{status=~\"[45]..\"}[5m]))",
          "legendFormat": "{{handler}} (HTTP {{status}})",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2
          },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "id": 4,
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "title": "System Errors by Component",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (component, type) (rate(gpay_remit_system_errors_total[5m]))",
          "legendFormat": "{{component}} - {{type}}",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "id": 102,
      "title": "Database Connection Pool",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20
          },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 19 },
      "id": 5,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "title": "PostgreSQL Connection Pool Usage",
      "type": "timeseries",
      "targets": [
        {
          "expr": "gpay_remit_db_open_connections",
          "legendFormat": "Open Connections",
          "refId": "A"
        },
        {
          "expr": "gpay_remit_db_in_use_connections",
          "legendFormat": "In-Use Connections",
          "refId": "B"
        },
        {
          "expr": "gpay_remit_db_idle_connections",
          "legendFormat": "Idle Connections",
          "refId": "C"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line"
          },
          "unit": "s"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 19 },
      "id": 6,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "title": "Database Connection Wait Metrics",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(gpay_remit_db_wait_duration_seconds_total[5m])",
          "legendFormat": "Wait Duration (sec/sec)",
          "refId": "A"
        },
        {
          "expr": "rate(gpay_remit_db_wait_count_total[5m])",
          "legendFormat": "Wait Count Rate (/sec)",
          "refId": "B"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 },
      "id": 103,
      "title": "Redis Cache Performance",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "green", "value": 90 }
            ]
          },
          "unit": "percent"
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 28 },
      "id": 7,
      "options": {
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "title": "Redis Cache Hit Ratio",
      "type": "gauge",
      "targets": [
        {
          "expr": "((rate(gpay_remit_redis_hits_total[5m]) + 0.001) / (rate(gpay_remit_redis_hits_total[5m]) + rate(gpay_remit_redis_misses_total[5m]) + 0.001)) * 100",
          "legendFormat": "Hit Ratio %",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15
          },
          "unit": "ops"
        }
      },
      "gridPos": { "h": 8, "w": 16, "x": 8, "y": 28 },
      "id": 8,
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "title": "Redis Hits vs Misses Rate",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(gpay_remit_redis_hits_total[5m])",
          "legendFormat": "Cache Hits",
          "refId": "A"
        },
        {
          "expr": "rate(gpay_remit_redis_misses_total[5m])",
          "legendFormat": "Cache Misses",
          "refId": "B"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 36 },
      "id": 104,
      "title": "Webhook Deliveries & Retries",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20
          },
          "unit": "ops"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 37 },
      "id": 9,
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "title": "Webhook Deliveries by Status",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (status) (rate(gpay_remit_webhook_deliveries_total[5m]))",
          "legendFormat": "Delivery: {{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20
          },
          "unit": "ops"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 37 },
      "id": 10,
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "title": "Webhook Retries & Dead Letters",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (kind, outcome) (rate(gpay_remit_webhook_retry_attempts_total[5m]))",
          "legendFormat": "Retry: {{kind}} - {{outcome}}",
          "refId": "A"
        },
        {
          "expr": "sum by (reason) (rate(gpay_remit_webhook_dead_letters_total[5m]))",
          "legendFormat": "Dead Letter: {{reason}}",
          "refId": "B"
        }
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["gpay-remit", "stellar", "api", "backend"],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m", "5m"]
  },
  "timezone": "browser",
  "title": "Gpay-Remit / System Overview",
  "uid": "gpay-remit-overview",
  "version": 1
}
