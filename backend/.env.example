PORT=8080
DATABASE_URL=postgres://gpay:gpay_password@localhost:5432/gpay_remit?sslmode=disable
# Optional PostgreSQL standby for analytics/history/search/export reads.
# Leave empty to use DATABASE_URL for reads as well.
DATABASE_READ_REPLICA_URL=

# Secrets provider (#193): "env" (default) reads secrets below straight from
# these environment variables, same as before. Set to "aws" in production to
# read them from AWS Secrets Manager instead — create secrets there named
# exactly JWT_SECRET / JWT_REFRESH_SECRET (or change the names passed to
# secretsProvider.GetSecret in config/config.go), and ensure AWS credentials
# are available via the standard SDK credential chain (env vars, shared
# config file, or an EC2/ECS/Lambda instance role). See backend/secrets/.
SECRETS_PROVIDER=env

# JWT Secrets (REQUIRED - Generate secure 32+ character random strings. Server enforces min 32 chars and runs signing/verification self-test on startup; no default fallback)
# SECURITY: These must be set and should be at least 32 characters long
# Example generation: openssl rand -hex 32
# Ignored when SECRETS_PROVIDER=aws — the values instead come from AWS
# Secrets Manager secrets named JWT_SECRET / JWT_REFRESH_SECRET.
JWT_SECRET=your-secret-jwt-key-min-32-chars-required-change-me-in-production
JWT_REFRESH_SECRET=your-secret-refresh-key-min-32-chars-required-change-me-in-production

# Stellar Network Configuration
# STELLAR_NETWORK selects testnet or pubnet; the passphrase is derived from it.
# STELLAR_HORIZON_URL is the Horizon endpoint for the selected network.
# HORIZON_URL is still accepted as a backwards-compatible alias.
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
HORIZON_URL=https://horizon-testnet.stellar.org
NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Smart Contract IDs (populated by deployment script)
CONTRACT_ID=
ESCROW_CONTRACT_ID=
KYC_ORACLE_ID=
AML_ORACLE_ID=
PRICE_ORACLE_ID=

# Fees (basis points)
PLATFORM_FEE_BPS=50
FOREX_FEE_BPS=25
COMPLIANCE_FEE_BPS=10
NETWORK_FEE_BPS=15
MIN_FEE=0
MAX_FEE=0

# Database Connection Pool
DB_MAX_IDLE_CONNS=10
DB_MAX_OPEN_CONNS=100
DB_CONN_MAX_LIFETIME_MIN=60
# Email Configuration
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@gpay-remit.com

# Redis Configuration
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# Application Environment & TLS
APP_ENV=development
# Log level: debug, info, warn, error, or fatal
LOG_LEVEL=info
TLS_ENABLED=false

# Rate Limiter Configuration (redis | memory)
RATE_LIMIT_BACKEND=memory

# Exchange rate cache TTL (Go duration), default 60s
EXCHANGE_RATE_CACHE_TTL=60s

# Master key for encrypting sensitive fields at rest (webhook signing secrets,
# PII). Generate with: openssl rand -base64 32. Keep it stable across restarts.
ENCRYPTION_KEY=

# CORS: explicit origins only. Wildcards are rejected. http:// is allowed only
# for localhost; use https:// for every deployed origin.
CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-API-Version,Accept-Version,X-CSRF-Token,X-Request-ID,X-Correlation-ID
CORS_EXPOSED_HEADERS=X-Request-ID,X-RateLimit-Limit,X-RateLimit-Remaining,X-RateLimit-Reset
CORS_ALLOW_CREDENTIALS=false
CORS_MAX_AGE=10m
